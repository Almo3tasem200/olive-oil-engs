# Copy to .env for local development. Replace defaults before production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/el_mohandeseen?schema=public
STORE_BASE_URL=http://localhost:3000

# Generate a random 32-byte hex value for production.
APP_ENCRYPTION_KEY=

# Image storage: local is for development only; use s3 for production.
MEDIA_DRIVER=local
MEDIA_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional server-side order alert adapters. Leave unset until configured.
BUSINESS_ALERT_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=

# Cookie/config
SESSION_COOKIE_NAME=emo_admin_session
SESSION_TTL_DAYS=7
MAX_UPLOAD_BYTES=12582912

